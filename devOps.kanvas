    {
      "id": "el_s67sjm51",
      "type": "code",
      "x": 414.99590647561024,
      "y": 390.60600715125116,
      "width": 910,
      "height": 213,
      "code": "git remote add origin <URL> \n# CONNECTS REMOTE TO LOCAL\n\ngit branch -m main\n# RENAMES CURRENT MASTER BRANCH TO MAIN(DEFAULT MASTER IN LOCAL => DEFALT MAIN IN GITHUB)\n\ngit push -u origin main\n# CONNECTS REMOTE MAIN => LOCAL MAIN",
      "language": "bash",
      "codeTheme": "dark",
      "showLineNumbers": false,
      "fontSize": 13,
      "strokeColor": "#ffffff",
      "seed": 1369278218,
      "editing": false
    },
    {
      "id": "el_anhy8vq6",
      "type": "text",
      "x": 423,
      "y": 632.176812775001,
      "width": 911.913818359375,
      "height": 30.83034915589856,
      "text": "Q. what is ADD in dockerfile? and what is diff between ADD and COPY?",
      "fontSize": 24.664279324718848,
      "fontFamily": "handwritten",
      "strokeColor": "#e03131",
      "fillColor": "transparent",
      "strokeWidth": 2,
      "seed": 803269536,
      "editing": false
    },
    {
      "id": "el_2f3hpktz",
      "type": "text",
      "x": 425.13127731371424,
      "y": 667.9601243371801,
      "width": 884.130859375,
      "height": 125,
      "text": "=> ADD same like copy for most cases but Add can use to dowload from url or extract\nzip.\n\nex: ADD https://kanvas.usecerebro.co.in ./\n    ADD abc.zip ./",
      "fontSize": 20,
      "fontFamily": "handwritten",
      "strokeColor": "#1971c2",
      "fillColor": "transparent",
      "strokeWidth": 2,
      "seed": 1997752036,
      "editing": false
    },
    {
      "id": "el_a9488f1g",
      "type": "text",
      "x": 423.3535919864885,
      "y": 817.3520963876879,
      "width": 223.15603637695312,
      "height": 30.83034915589856,
      "text": "Q. what is image?",
