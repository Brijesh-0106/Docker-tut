    },
    {
      "id": "el_zh9y3sww",
      "type": "text",
      "x": 420.38341453318566,
      "y": 303.7168310037256,
      "width": 648.0872885918143,
      "height": 50,
      "text": "DevOps is basically after development how can you frequently\nand reliably you can deliver feature/updates",
      "fontSize": 20.657133006023617,
      "fontFamily": "handwritten",
      "strokeColor": "#ffffff",
      "fillColor": "transparent",
